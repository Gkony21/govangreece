# Response headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# Pages already sends X-Content-Type-Options and Referrer-Policy, so they are not repeated here.
#
# - Strict-Transport-Security: browsers remember to use HTTPS only, for a year.
# - Content-Security-Policy: only this site's own files may load. Inline scripts and styles are
#   needed by Next.js; the two cloudflareinsights hosts are Cloudflare Web Analytics;
#   challenges.cloudflare.com is Turnstile, the quote form's check (a script and its frame).
#   Forms may only post to this site (/api/quote).
# - X-Frame-Options / frame-ancestors: the site may not be shown inside another site's frame.
# - Cross-Origin-Opener-Policy: other sites opened from here cannot reach back into this window.
# - Permissions-Policy: the site uses no camera, microphone, location or payments.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The production site also answers on govangreece.pages.dev: only govangreece.gr should be in search results.
# (Preview and branch links already get noindex from Cloudflare.)
https://govangreece.pages.dev/*
  X-Robots-Tag: noindex

# Build files have the content hash in their name, so they never change and can be cached for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
